  "situations": [
    "wrap",
    "level"
  ],
  "wrapOn": true,
  "sections": [
    {
      "role": "start",
      "title": "시작 질문",
      "blocks": [
        {
          "id": "s1",
          "kind": "choice",
          "method": "객관식",
          "prompt": "지하철 노선도에는 실제 거리나 건물이 없어요. 그래도 길을 찾을 수 있는 이유는?",
          "options": [
            "역과 연결 관계처럼 필요한 정보만 남겼기 때문에",
            "그림이 예뻐서"
          ],
          "answer": 0,
          "explain": "노선도는 길 찾기에 필요한 핵심만 남긴 추상화의 대표적인 예예요."
        }
      ]
    },
    {
      "role": "main",
      "title": "예측하고 확인하기",
      "blocks": [
        {
          "id": "m1",
          "kind": "sort",
          "method": "분류하기",
          "prompt": "\"학교 축제 부스 안내도\"를 만들어요. 남길 정보와 뺄 정보로 분류하세요.",
          "groups": [
            "남길 정보",
            "뺄 정보"
          ],
          "items": [
            {
              "t": "부스 이름",
              "g": 0
            },
            {
              "t": "부스 위치",
              "g": 0
            },
            {
              "t": "출입구",
              "g": 0
            },
            {
              "t": "화장실 위치",
              "g": 0
            },
            {
              "t": "복도 벽 색깔",
              "g": 1
            },
            {
              "t": "화단의 나무 종류",
              "g": 1
            },
            {
              "t": "교실 책상 수",
              "g": 1
            }
          ],
          "explain": "안내도의 목적은 부스를 찾아가는 것이에요. 목적과 관계없는 정보는 빼야 더 잘 보여요."
        },
        {
          "id": "m2",
          "kind": "multi",
          "method": "객관식",
          "prompt": "\"반 티셔츠 주문하기\"를 작은 문제로 나눈 것으로 알맞은 것을 모두 고르세요.",
          "options": [
            "디자인 정하기",
            "친구들의 사이즈 조사하기",
            "가격과 예산 확인하기",
            "티셔츠라는 말의 유래 찾기"
          ],
          "answer": [
            0,
            1,
            2
          ],
          "explain": "큰 문제를 해결에 꼭 필요한 작은 문제로 나누면 하나씩 해결할 수 있어요. 이것도 추상화의 한 과정이에요."
        },
        {
          "id": "m3",
          "kind": "fixsentence",
          "method": "문장 고치기",
          "prompt": "틀린 낱말을 눌러 바꿔서 올바른 문장으로 만드세요.",
          "parts": [
            "추상화는 문제의 ",
            {
              "now": "모든",
              "options": [
                "모든",
                "핵심"
              ],
              "answer": "핵심"
            },
            " 요소만 남기고 ",
            {
              "now": "핵심",
              "options": [
                "핵심",
                "불필요한"
              ],
              "answer": "불필요한"
            },
            " 부분은 없애는 과정이다."
          ],
          "explain": "모든 것을 남기면 복잡해져요. 핵심만 남기는 것이 추상화예요."
        }
      ]
    },
    {
      "role": "wrap",
      "title": "한 줄 정리",
      "blocks": [
        {
          "id": "w1",
          "kind": "write",
          "method": "서술형",
          "prompt": "추상화가 문제 해결에 도움이 되는 이유를 \"핵심\"과 \"추상화\"를 넣어 한 문장으로 써 보세요.",
          "keywords": [
            "핵심",
            "추상화"
          ],
          "sample": "추상화로 핵심만 남기면 복잡한 문제도 단순해져서 해결 방법을 찾기 쉽다."
        }
      ]
    }
  ]
}